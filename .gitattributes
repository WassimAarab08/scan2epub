# Normalise line endings: check out LF, commit as-is.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.epub binary
*.zip binary
*.onnx binary
*.safetensors binary
*.bin binary
*.mlmodel binary

# Lock files must not be merged
uv.lock -merge
package-lock.json -merge
